<resources>
    <style name="AppTheme" parent="SaveWhyThemeBase" />
    <style name="SaveWhyThemeBase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_surface_soft</item>
        <item name="colorOnPrimaryContainer">@color/app_primary</item>
        <item name="colorSecondary">@color/app_primary</item>
        <item name="colorSecondaryContainer">@color/app_surface_soft</item>
        <item name="colorOnSecondaryContainer">@color/app_primary</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text</item>
        <item name="colorOnSurfaceVariant">@color/app_muted</item>
        <item name="colorSurfaceVariant">@color/app_surface_soft</item>
        <item name="colorSurfaceContainer">@color/app_surface</item>
        <item name="colorSurfaceContainerLow">@color/app_surface</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_soft</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface_soft</item>
        <item name="colorSurfaceContainerLowest">@color/app_background</item>
        <item name="colorOutline">@color/app_border</item>
        <item name="colorOutlineVariant">@color/app_border</item>
        <item name="colorError">@color/app_error</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:fontFamily">@font/manrope_family</item>
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="textAppearanceBodyLarge">@style/SaveWhyBody</item>
        <item name="textAppearanceBodyMedium">@style/SaveWhyBody</item>
        <item name="textAppearanceLabelLarge">@style/SaveWhyLabel</item>
    </style>
    <style name="SaveWhyBody" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:fontFamily">@font/manrope_family</item>
    </style>
    <style name="SaveWhyLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:fontFamily">@font/manrope_family</item>
    </style>
</resources>
